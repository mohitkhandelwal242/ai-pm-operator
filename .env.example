# ==============================================================================
# AI-PM Operator — Environment Configuration Template
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Product License Key (From Gumroad / Lemon Squeezy)
OPERATOR_LICENSE_KEY=your_license_key_here

# Jira Integration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=PROJ

# Confluence Integration (Optional)
CONFLUENCE_SPACE_KEY=SPACE
CONFLUENCE_PARENT_PAGE_ID=1234567890

# Notification Channels (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Google Analytics 4 (Optional, used for Weekly/Monthly Reports)
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# Google Search Console (Optional, used for SEO Audits)
GSC_PROPERTY_URL=https://your-website.com
